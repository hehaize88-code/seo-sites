---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {languages,routes,pathFor,t} from '../lib/i18n.mjs';
import {content} from '../lib/content.mjs';
import {editorial,sourceById} from '../lib/editorial.mjs';
import {categoryRoute,categorySuffix} from '../lib/catalog-routes.mjs';
import {editorialDate} from '../lib/article-routes.mjs';
import EditorialPage from '../components/EditorialPage.astro';
import ArticleCards from '../components/ArticleCards.astro';
import FaqList from '../components/FaqList.astro';
import {categories,site} from '../site.config.mjs';
import {getCatalog} from '../lib/source.mjs';
export function getStaticPaths(){return Object.keys(languages).flatMap(lang=>routes.map(route=>({params:{path:pathFor(lang,route).replace(/^\/|\/$/g,'')||undefined},props:{lang,route}})));}
const {lang,route}=Astro.props,text=t(lang),copy=content[lang];
const home=route==='',catalog=route==='spreadsheet'||route.startsWith('spreadsheet/');
const category=route.startsWith('spreadsheet/')?route.split('/')[1]:'all';
const {ui,articles,faq,growth}=editorial(lang),article=articles.find(a=>'articles/'+a.slug===route);
const categoryCopy=growth.categories[category],hub=growth.hubs[route];
const categoryHref=key=>pathFor(lang,categoryRoute(key))+categorySuffix(key);
const isEditorial=route==='faq'||route==='articles'||!!article;
const hubTopics={guide:[2,4,10],qc:[3,6,8,12],shipping:[10,11,12,9]};
const hubArticles=(hubTopics[route]||[]).map(i=>articles[i]);
// A failed source fetch must fail the build, never publish an empty catalog.
const data=home||catalog?await getCatalog({category}):null;
const products=data?.products||[],heroProducts=[products[1],products[2],products[0]].filter(Boolean);
const title=article?article.title:route==='faq'?ui.faqTitle:route==='articles'?ui.articlesTitle:home?growth.homeTitle:catalog?(categoryCopy?.title||growth.catalogTitle):hub?hub.title:`Pikobuy · ${text.guide}`;
const description=article?article.description:route==='faq'?ui.faqIntro:route==='articles'?ui.articlesIntro:home?growth.homeDescription:catalog?(categoryCopy?.description||growth.catalogDescription):hub?hub.description:copy[0];
const structuredData=article?{'@context':'https://schema.org','@graph':[{'@type':'Article',headline:article.title,description:article.description,inLanguage:lang,datePublished:article.published||editorialDate,dateModified:article.updated||editorialDate,author:{'@type':'Organization',name:'PikobuySheet'},mainEntityOfPage:site.domain+pathFor(lang,route)},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'PikobuySheet',item:site.domain+pathFor(lang)},{'@type':'ListItem',position:2,name:ui.articles,item:site.domain+pathFor(lang,'articles')},{'@type':'ListItem',position:3,name:article.title,item:site.domain+pathFor(lang,route)}]}]}:route==='faq'?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}:catalog?{'@context':'https://schema.org','@graph':[{'@type':'CollectionPage',name:title,description,inLanguage:lang,url:site.domain+pathFor(lang,route)},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'PikobuySheet',item:site.domain+pathFor(lang)},{'@type':'ListItem',position:2,name:'Pikobuy spreadsheet',item:site.domain+pathFor(lang,'spreadsheet')},...(categoryCopy?[{'@type':'ListItem',position:3,name:categoryCopy.title,item:site.domain+pathFor(lang,route)}]:[])]}]}:undefined;
---
<Layout {lang} {route} {title} {description} {structuredData}>
  {home&&<>
    <section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span>{text.eyebrow}</p><h1>Pikobuy<br/><span>spreadsheet.</span></h1><p class="hero-description">{growth.homeDescription}</p><form class="search-box" action={pathFor(lang,'spreadsheet')}><span aria-hidden="true">⌕</span><input name="q" type="search" maxLength="100" placeholder={text.searchPlaceholder} aria-label={text.search}/><button aria-label={text.search}>↗</button></form><div class="hero-meta"><span>01 — {text.step1}</span><a href={pathFor(lang,'guide')}>{text.guide} <span aria-hidden="true">→</span></a></div></div>
      <div class="hero-visual"><div class="hero-grid-pattern"></div><span class="hero-visual-label">PIKOBUY SPREADSHEET</span>{heroProducts.map((p,i)=><button class={`hero-product hero-product-${i}`} data-product={p.id} aria-label={`${text.details}: ${p.title}`}><img src={p.image} alt={p.title} width="400" height="400" loading={i===0?'eager':'lazy'} referrerpolicy="no-referrer"/><span class="hero-product-caption"><span>{p.title}</span><strong>${p.price?.toFixed(2)}</strong></span></button>)}<span class="hero-note">{text.discover} <span>↗</span></span></div>
    </section>
    <section class="collection container" id="collection"><div class="section-heading"><div><p class="eyebrow">PIKOBUY SPREADSHEET</p><h2>{text.latest}<span class="purple-period">.</span></h2></div><a class="text-link" href={pathFor(lang,'spreadsheet')}>{text.browse} <span>↗</span></a></div><div class="category-tabs">{categories.slice(0,7).map(([key],i)=><a class:list={{selected:i===0}} href={categoryHref(key)}>{text.categoryLabels[i]}</a>)}</div><div class="product-grid">{products.slice(0,8).map(p=><ProductCard product={p} {text}/>)}</div>{!products.length&&<p class="empty-state">{text.error} <a href={pathFor(lang,'spreadsheet')}>{text.retry}</a></p>}<p class="price-note">{text.priceNote}</p></section>
    <section class="how-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{text.guide}</p><h2>{text.how}<span class="purple-period">.</span></h2></div><a href={pathFor(lang,'guide')} class="text-link">{text.guide} ↗</a></div><div class="steps">{[text.step1,text.step2,text.step3].map((label,i)=><article><span class="step-number">0{i+1}</span><h3>{label}</h3><p>{copy[i]}</p></article>)}</div></div></section>
    <section class="home-editorial container"><div class="section-heading"><div><p class="eyebrow">{ui.articleCount}</p><h2>{ui.latestArticles}<span class="purple-period">.</span></h2></div><a class="text-link" href={pathFor(lang,'articles')}>{ui.allArticles} ↗</a></div><ArticleCards {lang} limit={4} heading="h3"/></section>
    <section class="home-faq container"><div class="section-heading"><div><p class="eyebrow">PIKOBUY</p><h2>{ui.faqTitle}<span class="purple-period">.</span></h2></div><a class="text-link" href={pathFor(lang,'faq')}>{ui.faq} ↗</a></div><p class="faq-intro">{ui.faqIntro}</p><FaqList {lang}/></section>
    <section class="bottom-cta container"><div><p class="eyebrow">PIKOBUY SPREADSHEET</p><h2>{text.discover}.</h2></div><a class="button button-purple" href={pathFor(lang,'spreadsheet')}>{text.browse} <span>↗</span></a></section>
  </>}
  {catalog&&<section class="catalog container" id="catalog"><div class="catalog-heading"><div><p class="eyebrow">{text.discover}</p><h1>{categoryCopy?.title||growth.catalogTitle}<span class="purple-period">.</span></h1></div><p>{description}</p></div><div class="catalog-layout"><aside class="category-sidebar"><h2>{text.categories}</h2><div class="category-list">{categories.map(([key],i)=><a href={categoryHref(key)} data-category={key} class:list={{selected:key===category}}><span>{text.categoryLabels[i]}</span><span aria-hidden="true">↗</span></a>)}</div><div class="sidebar-tip"><span>01 / 03</span><h3>{text.step1}</h3><p>{copy[0]}</p><a href={pathFor(lang,'guide')}>{text.guide} →</a></div></aside><div class="catalog-results"><div class="catalog-toolbar"><form class="search-box compact" id="catalog-search" action={pathFor(lang,'spreadsheet')}><span aria-hidden="true">⌕</span><input type="search" name="q" maxLength="100" aria-label={text.search} placeholder={text.searchPlaceholder}/><button aria-label={text.search}>↗</button></form><label class="sort-control"><span class="sr-only">{text.sort}</span><select id="sort"><option value="new">{text.latest}</option><option value="popular">{text.popular}</option><option value="price-asc">{text.low}</option><option value="price-desc">{text.high}</option></select></label></div><div class="results-line"><span id="results-label">{text.categoryLabels[categories.findIndex(([key])=>key===category)]}</span><span id="page-top">{text.page} 1</span></div><div id="catalog-status" role="status" aria-live="polite" hidden></div><div class="product-grid catalog-grid" id="catalog-grid">{products.map(p=><ProductCard product={p} {text}/>)}</div><div class="pagination"><button id="previous" disabled>{text.previous} ←</button><span id="page-label">{text.page} 1</span><button id="next" disabled={!data?.hasNext}>{text.next} →</button></div><p class="price-note">{text.priceNote}</p></div></div>
    <section class="catalog-guidance"><h2>{growth.categoryGuideHeading}</h2>
      {categoryCopy&&<><p>{categoryCopy.intro}</p><ul>{categoryCopy.checks.map(check=><li>{check}</li>)}</ul></>}
      <div class="catalog-guide-links">{[category==='shoes'?'articles/pikobuy-shoe-sizing':'articles/pikobuy-clothing-size-chart','articles/pikobuy-spreadsheet-checklist','articles/pikobuy-qc-measurements','articles/pikobuy-shipping-calculator'].map(path=><a href={pathFor(lang,path)}>{articles.find(a=>'articles/'+a.slug===path)?.title} ↗</a>)}</div>
    </section>
  </section>}
  {['guide','qc','shipping'].includes(route)&&<section class="guide-page container"><a class="back-link" href={pathFor(lang)}>← Pikobuy spreadsheet</a><div class="guide-heading"><p class="eyebrow">PIKOBUY SPREADSHEET</p><h1>{hub?.title||text.guide}<span class="purple-period">.</span></h1></div><div class="guide-layout"><article class="guide-content">{route==='guide'?<>{[text.step1,text.step2,text.step3].map((label,i)=><section><span class="step-number">0{i+1}</span><h2>{label}</h2><p>{copy[i]}</p></section>)}</>:<><p class="hub-intro">{hub.description}</p>{hub.sections.map(s=><section id={s.id}><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}<section class="article-sources"><h2>{ui.sources}</h2><ul>{hub.sourceIds.map(id=><li><a href={sourceById[id].url} target="_blank" rel="noopener noreferrer">{ui.sourceLink} ↗</a></li>)}</ul></section></>}<a class="button button-purple" href={pathFor(lang,'spreadsheet')}>{text.browse} ↗</a></article><aside class="guide-aside">{hubArticles.map(a=><a href={pathFor(lang,'articles/'+a.slug)}>{a.title} ↗</a>)}<a href={pathFor(lang,'articles')}>{ui.articles} ↗</a><a href={pathFor(lang,'faq')}>{ui.faq} ↗</a><h3>Pikobuy spreadsheet</h3><p>{text.intro}</p>{[['guide',text.guide],['qc',text.qcGuide],['shipping',text.shipping]].filter(([r])=>r!==route).map(([r,label])=><a href={pathFor(lang,r)}>{label} <span>↗</span></a>)}<a href={site.register} target="_blank" rel="noopener noreferrer">{text.register} ↗</a></aside></div></section>}
  {isEditorial&&<EditorialPage {lang} {route}/>}
</Layout>
