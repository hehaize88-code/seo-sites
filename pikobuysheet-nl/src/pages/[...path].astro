---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {languages,routes,pathFor,t} from '../lib/i18n.mjs';
import {content} from '../lib/content.mjs';
import {categories,site} from '../site.config.mjs';
import {getCatalog} from '../lib/source.mjs';
export function getStaticPaths(){return Object.keys(languages).flatMap(lang=>routes.map(route=>({params:{path:pathFor(lang,route).replace(/^\/|\/$/g,'')||undefined},props:{lang,route}})));}
const {lang,route}=Astro.props,text=t(lang),copy=content[lang];
const home=route==='',catalog=route==='spreadsheet';
let data=null;if(home||catalog){try{data=await getCatalog();}catch{}}
const products=data?.products||[],heroProducts=[products[1],products[2],products[0]].filter(Boolean);
const title=home?'Pikobuy spreadsheet':catalog?`Pikobuy spreadsheet · ${text.all}`:route==='guide'?`Pikobuy · ${text.guide}`:route==='qc'?`Pikobuy · ${text.qcGuide}`:`Pikobuy · ${text.shipping}`;
const description=(home||catalog)?text.intro:route==='guide'?copy[0]:route==='qc'?copy[3]:copy[4];
---
<Layout {lang} {route} {title} {description}>
  {home&&<>
    <section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span>{text.eyebrow}</p><h1>Pikobuy<br/><span>spreadsheet.</span></h1><p class="hero-description">{text.intro}</p><form class="search-box" action={pathFor(lang,'spreadsheet')}><span aria-hidden="true">⌕</span><input name="q" type="search" maxLength="100" placeholder={text.searchPlaceholder} aria-label={text.search}/><button aria-label={text.search}>↗</button></form><div class="hero-meta"><span>01 — {text.step1}</span><a href={pathFor(lang,'guide')}>{text.guide} <span aria-hidden="true">→</span></a></div></div>
      <div class="hero-visual"><div class="hero-grid-pattern"></div><span class="hero-visual-label">PIKOBUY SPREADSHEET</span>{heroProducts.map((p,i)=><button class={`hero-product hero-product-${i}`} data-product={p.id} aria-label={`${text.details}: ${p.title}`}><img src={p.image} alt={p.title} width="400" height="400" loading={i===0?'eager':'lazy'} referrerpolicy="no-referrer"/><span class="hero-product-caption"><span>{p.title}</span><strong>${p.price?.toFixed(2)}</strong></span></button>)}<span class="hero-note">{text.discover} <span>↗</span></span></div>
    </section>
    <section class="collection container" id="collection"><div class="section-heading"><div><p class="eyebrow">PIKOBUY SPREADSHEET</p><h2>{text.latest}<span class="purple-period">.</span></h2></div><a class="text-link" href={pathFor(lang,'spreadsheet')}>{text.browse} <span>↗</span></a></div><div class="category-tabs">{categories.slice(0,7).map(([key],i)=><a class:list={{selected:i===0}} href={`${pathFor(lang,'spreadsheet')}${key==='all'?'':'?category='+key}`}>{text.categoryLabels[i]}</a>)}</div><div class="product-grid">{products.slice(0,8).map(p=><ProductCard product={p} {text}/>)}</div>{!products.length&&<p class="empty-state">{text.error} <a href={pathFor(lang,'spreadsheet')}>{text.retry}</a></p>}<p class="price-note">{text.priceNote}</p></section>
    <section class="how-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{text.guide}</p><h2>{text.how}<span class="purple-period">.</span></h2></div><a href={pathFor(lang,'guide')} class="text-link">{text.guide} ↗</a></div><div class="steps">{[text.step1,text.step2,text.step3].map((label,i)=><article><span class="step-number">0{i+1}</span><h3>{label}</h3><p>{copy[i]}</p></article>)}</div></div></section>
    <section class="bottom-cta container"><div><p class="eyebrow">PIKOBUY SPREADSHEET</p><h2>{text.discover}.</h2></div><a class="button button-purple" href={pathFor(lang,'spreadsheet')}>{text.browse} <span>↗</span></a></section>
  </>}
  {catalog&&<section class="catalog container" id="catalog"><div class="catalog-heading"><div><p class="eyebrow">{text.discover}</p><h1>Pikobuy spreadsheet<span class="purple-period">.</span></h1></div><p>{text.intro}</p></div><div class="catalog-layout"><aside class="category-sidebar"><h2>{text.categories}</h2><div class="category-list">{categories.map(([key],i)=><a href={`${pathFor(lang,'spreadsheet')}${key==='all'?'':'?category='+key}`} data-category={key} class:list={{selected:i===0}}><span>{text.categoryLabels[i]}</span><span aria-hidden="true">↗</span></a>)}</div><div class="sidebar-tip"><span>01 / 03</span><h3>{text.step1}</h3><p>{copy[0]}</p><a href={pathFor(lang,'guide')}>{text.guide} →</a></div></aside><div class="catalog-results"><div class="catalog-toolbar"><form class="search-box compact" id="catalog-search" action={pathFor(lang,'spreadsheet')}><span aria-hidden="true">⌕</span><input type="search" name="q" maxLength="100" aria-label={text.search} placeholder={text.searchPlaceholder}/><button aria-label={text.search}>↗</button></form><label class="sort-control"><span class="sr-only">{text.sort}</span><select id="sort"><option value="new">{text.latest}</option><option value="popular">{text.popular}</option><option value="price-asc">{text.low}</option><option value="price-desc">{text.high}</option></select></label></div><div class="results-line"><span id="results-label">{text.all}</span><span id="page-top">{text.page} 1</span></div><div id="catalog-status" role="status" aria-live="polite" hidden></div><div class="product-grid catalog-grid" id="catalog-grid">{products.map(p=><ProductCard product={p} {text}/>)}</div><div class="pagination"><button id="previous" disabled>{text.previous} ←</button><span id="page-label">{text.page} 1</span><button id="next" disabled={!data?.hasNext}>{text.next} →</button></div><p class="price-note">{text.priceNote}</p></div></div></section>}
  {!home&&!catalog&&<section class="guide-page container"><a class="back-link" href={pathFor(lang)}>← Pikobuy spreadsheet</a><div class="guide-heading"><p class="eyebrow">PIKOBUY SPREADSHEET</p><h1>{route==='guide'?text.guide:route==='qc'?text.qcGuide:text.shipping}<span class="purple-period">.</span></h1></div><div class="guide-layout"><article class="guide-content">{route==='guide'?<>{[text.step1,text.step2,text.step3].map((label,i)=><section><span class="step-number">0{i+1}</span><h2>{label}</h2><p>{copy[i]}</p></section>)}</>:<><span class="article-icon" aria-hidden="true">{route==='qc'?'◎':'↗'}</span><h2>Pikobuy {route==='qc'?'QC':text.shipping}</h2><p>{route==='qc'?copy[3]:copy[4]}</p><p class="guide-note">{text.priceNote}</p></>}<a class="button button-purple" href={pathFor(lang,'spreadsheet')}>{text.browse} ↗</a></article><aside class="guide-aside"><h3>Pikobuy spreadsheet</h3><p>{text.intro}</p>{[['guide',text.guide],['qc',text.qcGuide],['shipping',text.shipping]].filter(([r])=>r!==route).map(([r,label])=><a href={pathFor(lang,r)}>{label} <span>↗</span></a>)}<a href={site.register} target="_blank" rel="noopener noreferrer">{text.register} ↗</a></aside></div></section>}
</Layout>
