---
import ArticleCards from './ArticleCards.astro';
import FaqList from './FaqList.astro';
import {editorial,sourceById} from '../lib/editorial.mjs';
import {pathFor,t} from '../lib/i18n.mjs';
import {editorialDate} from '../lib/article-routes.mjs';
const {lang,route}=Astro.props;
const {articles,ui}=editorial(lang),text=t(lang);
const article=articles.find(a=>'articles/'+a.slug===route);
const checkedDate=article?.updated||article?.published||(route==='articles'?'2026-10-29':editorialDate);
const date=new Intl.DateTimeFormat(lang,{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(new Date(checkedDate));
function labelFor(path){return path==='spreadsheet'?'Pikobuy spreadsheet':path==='guide'?text.guide:path==='shipping'?text.shipping:path==='qc'?text.qcGuide:path==='faq'?ui.faq:articles.find(a=>'articles/'+a.slug===path)?.title||ui.articles;}
---
<section class:list={['editorial-page','container',{'article-detail':!!article}]}>
  <a class="back-link" href={pathFor(lang,article?'articles':'')}>← {article?ui.allArticles:'Pikobuy spreadsheet'}</a>
  <header class="editorial-heading"><p class="eyebrow">{article?ui.articles:'PIKOBUY SPREADSHEET'}</p><h1>{article?.title||(route==='faq'?ui.faqTitle:ui.articlesTitle)}</h1><p class="editorial-intro">{article?.intro||(route==='faq'?ui.faqIntro:ui.articlesIntro)}</p><div class="editorial-meta">{article?<span>{ui.byline}</span>:route==='articles'?<span>{ui.articleCount}</span>:null}<span>{ui.checked} <time datetime={checkedDate}>{date}</time></span></div></header>
  {route==='articles'&&<ArticleCards {lang}/>}
  {route==='faq'&&<FaqList {lang}/>}
  {article&&<div class="article-layout"><aside class="article-toc"><details open><summary>{ui.toc}</summary><ol>{article.sections.map(section=><li><a href={'#'+section.id}>{section.heading}</a></li>)}</ol></details></aside><article class="article-body">{article.sections.map(section=><section id={section.id}><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}{section.list&&<ul>{section.list.map(item=><li>{item}</li>)}</ul>}{section.table&&<table class="editorial-table"><thead><tr>{section.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{section.table.rows.map(row=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td data-label={section.table.headers[i]}>{cell}</td>)}</tr>)}</tbody></table>}</section>)}<section class="article-sources"><h2>{ui.sources}</h2><ul>{article.sourceIds.map(id=><li><a href={sourceById[id].url} target="_blank" rel="noopener noreferrer">{sourceById[id].title} ↗</a></li>)}</ul><p class="source-date">{ui.checked} <time datetime={checkedDate}>{date}</time></p></section><section class="related-reading"><h2>{ui.related}</h2><div>{article.related.map(path=><a href={pathFor(lang,path)}>{labelFor(path)} <span aria-hidden="true">↗</span></a>)}</div></section></article></div>}
</section>
