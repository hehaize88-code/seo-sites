---
const {product:p, text} = Astro.props;
---
<article class="product-card">
  <button class="product-picture" data-product={p.id} aria-label={`${text.details}: ${p.title}`}>
    {p.image?<img src={p.image} alt={p.title} loading="lazy" width="480" height="480" referrerpolicy="no-referrer" />:<span class="image-unavailable">{text.gallery} —</span>}
    <span class="picture-arrow" aria-hidden="true">↗</span>
  </button>
  <div class="product-info"><button class="product-title" data-product={p.id}>{p.title}</button><span class="product-price">{p.price===null?'—':`$${p.price.toFixed(2)}`} <small>USD</small></span></div>
</article>
