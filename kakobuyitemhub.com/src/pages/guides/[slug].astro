---
import Shell from '../../layouts/Shell.astro';import {locale,translator} from '../../lib/i18n';import {guides,editorialCopy} from '../../lib/guides';
import SourceLinks from '../../components/SourceLinks.astro';import EditorialNotice from '../../components/EditorialNotice.astro';
const lang=locale(Astro.url);const t=translator(lang);const c=(s:string[])=>editorialCopy(s,lang);const guide=guides.find(g=>g.slug===Astro.params.slug);if(!guide)Astro.response.status=404;
---
<Shell title={(guide?c(guide.title):'404')+' | Kakobuy Spreadsheet'} description={guide?c(guide.summary):undefined}><main class="article-page"><a class="back" href={'/guides?lang='+lang}>← {t('Articles & guides','文章与指南')}</a><EditorialNotice lang={lang}/>{guide?<article lang={lang==='zh'?'zh-CN':lang}><div class="eyebrow">KAKOBUY / {t("BUYER GUIDE","购买指南")}</div><h1>{c(guide.title)}</h1><p class="article-intro">{c(guide.summary)}</p><p class="review-date">{t("Official information checked: ","官网资料核对日期：")}<time datetime={guide.reviewed}>{guide.reviewed}</time></p><nav class="article-toc" aria-label={t("On this page","本文目录")}><strong>{t("On this page","本文目录")}</strong><ol>{guide.sections.map((s,i)=><li><a href={'#section-'+(i+1)}>{c(s.heading)}</a></li>)}</ol></nav>{guide.sections.map((s,i)=><section id={'section-'+(i+1)}><h2>{c(s.heading)}</h2><p>{c(s.body)}</p><SourceLinks ids={s.sources} lang={lang}/></section>)}<aside class="buyer-checklist"><h2>{t("Before you continue","操作前检查")}</h2><p>{c(guide.checklist)}</p></aside><p class="editorial-note">{t("Platform rules and available services can change. Check the official help and your own order page together. Examples and practical recommendations are not platform promises.","平台规则及可用服务可能调整，请同时核对官网说明与自己的订单页面。文中的示例和操作建议不构成平台承诺。")}</p><section class="related-guides"><h2>{t("Continue reading","继续阅读")}</h2><ul>{guide.related.map(slug=>{const related=guides.find(g=>g.slug===slug);return related&&<li><a href={'/guides/'+slug+'?lang='+lang}>{c(related.title)} →</a></li>})}</ul></section><div class="article-links"><a href={'/?lang='+lang+'#finds'}>{t('Browse all finds','浏览全部商品')} →</a><a href={'/faq?lang='+lang}>{t('FAQ','常见问题')} →</a></div></article>:<h1>404</h1>}</main></Shell>
