---
import {usd} from '../../lib/money';
import PriceNote from '../../components/PriceNote.astro';
import {locale,translator} from "../../lib/i18n";
import Shell from '../../layouts/Shell.astro';import {detail} from '../../lib/source';
const lang=locale(Astro.url);const zh=lang==='zh';const t=translator(lang);let p:any=null;let failed=false;try{p=await detail(Astro.params.id||'');}catch{failed=true;}if(!p)Astro.response.status=failed?503:404;
---
<Shell title={p?p.title+' | Kakobuy Spreadsheet':t('Product unavailable','商品暂不可用')}><main class="detail-page"><a class="back" href={'/?lang='+lang+'#finds'}>← {t('Back to the finds','返回商品列表')}</a>{p?<><div class="detail-layout"><div><div class="detail-main">{p.images[0]&&<img id="main-photo" data-product src={p.images[0]} alt={p.title}/>}</div><div class="thumbs">{p.images.map((src:string)=><button data-photo={src} aria-label={t('View product photo','查看商品图片')}><img src={src} alt={p.title} loading="lazy"/></button>)}</div></div><div class="detail-copy"><div class="eyebrow">CNFANSHM · {p.sourceId}</div><h1>{p.title}</h1><p class="detail-price">{usd(p.price)} <small>{t('Estimated USD','美元参考价')}</small></p><p>{t('Take a closer look. These images come directly from the original source listing.','仔细看看：图片直接来自主站商品相册。')}</p>{p.buy&&<a class="button wide" href={p.buy} rel="sponsored noopener" target="_blank">{t('Open in Kakobuy','前往 Kakobuy 购买')} ↗</a>}{p.source&&<a class="source-link" href={p.source} rel="noopener" target="_blank">{t('View original marketplace listing','查看原始商品链接')} ↗</a>}<PriceNote lang={lang}/><div class="detail-notice"><b>{t('Before you order','下单前请核实')}</b><p>{t('Confirm currency, current price, size, colour, shipping and fees on Kakobuy. The gallery is not verified warehouse QC.','请在 Kakobuy 核实币种、价格、尺码、颜色、运费和费用。此相册不代表已验证的仓库 QC。')}</p></div><a href={'https://cnfanshm.com/AllProducts/'+p.id+'.html'} target="_blank" rel="noopener">{t('View on cnfanshm','在主站查看')} ↗</a></div></div></>:<div class="empty"><h1>{t('Product unavailable','商品暂不可用')}</h1><p>{failed?t('The source could not be reached. Please try again.','暂时无法连接主站，请稍后重试。'):t('This product was not found.','没有找到这个商品。')}</p></div>}</main><script>document.querySelectorAll('[data-photo]').forEach(b=>b.addEventListener('click',()=>{const img=document.querySelector('#main-photo') as HTMLImageElement;if(img){img.src=(b as HTMLElement).dataset.photo!;img.style.display='block';}}));</script></Shell>
