---
import {usd} from '../lib/money';
import PriceNote from '../components/PriceNote.astro';
import {locale,translator} from "../lib/i18n";
import Shell from '../layouts/Shell.astro';
import ImageSearch from '../components/ImageSearch.astro';
import HomeReading from '../components/HomeReading.astro';
import {catalogue,register,categories} from '../lib/source';
const lang=locale(Astro.url);const zh=lang==='zh';const t=translator(lang);
const q=(Astro.url.searchParams.get('q')||'').slice(0,160);const sort=Astro.url.searchParams.get('sort')||'new';const category=Astro.url.searchParams.get('category')||'';
let products:any[]=[];let failed=false;try{products=await catalogue(q,sort,category);}catch{failed=true;}
const hero=products.filter(p=>p.image).slice(0,3);
const url=(cat:string)=>'/?'+new URLSearchParams({lang,category:cat}).toString()+'#finds';
---
<Shell>
<main>
<section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="dot"></span>{t('THE GOOD FINDS START HERE','好物发现，从这里开始')}</div><h1>Kakobuy<br/><span>Spreadsheet.</span></h1><p class="intro">{t('Less searching. More finding.','少一点翻找，多一点发现。')}<br/>{t('Explore products, take a closer look, and bring your next haul together.','浏览商品与来源图片，找到你下一单想买的好物。')}</p><form class="search" action="/#finds"><span>⌕</span><input name="q" aria-label={t('Search products','搜索商品')} placeholder={t('Search shoes, hoodies, accessories…','搜索 shoes、hoodies、配饰…')} value={q}/><input type="hidden" name="lang" value={lang}/><button type="button" class="image-search-trigger" data-image-search aria-haspopup="dialog" aria-controls="image-search-dialog" aria-label={t('Search with an image','以图搜商品')} title={t('Search with an image','以图搜商品')}><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 5h-4L8 8H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1h-4z"/><circle cx="12" cy="13" r="3.5"/></svg></button><button aria-label={t('Search','搜索')}>→</button></form><div class="hero-tags"><span>{t('Start with','从这里开始')}</span><a href={url('shoes')}>{t('Shoes','鞋履')} ↗</a><a href={url('hoodies')}>{t('Hoodies & sweaters','卫衣 / 毛衣')} ↗</a><a href={url('accessories')}>{t('Accessories','配饰')} ↗</a></div><div class="hero-note"><span>✓</span>{t('Real product listings · Direct Kakobuy links','真实商品资料 · 直达 Kakobuy 购买链接')}</div></div>
<div class="hero-art"><div class="orbit"></div><span class="art-label">{t('YOUR NEXT PICK','下一件心仪好物')} / 01</span>{hero.map((p,i)=><a class={'hero-product hp'+i} href={'/products/'+p.id+'?lang='+lang}><img data-product src={p.image} alt={p.title} loading={i?'lazy':'eager'}/><div><span>{p.title}</span><b>↗</b></div></a>)}{hero.length===0&&<div class="hero-empty">{t('Your next find starts with a search.','下一件心仪商品，从搜索开始。')}</div>}<div class="edit-stamp">{t('Your next haul,','你的下一单，')}<br/><b>{t('a little simpler.','更简单一点。')} ↗</b></div></div></section>
<div class="benefit-strip"><span>01 <b>{t('Discover a find','发现商品')}</b></span><i>→</i><span>02 <b>{t('Explore the photos','查看图片')}</b></span><i>→</i><span>03 <b>{t('Open in Kakobuy','前往 Kakobuy')}</b></span></div>
<section class="catalogue" id="finds"><div class="section-head"><div class="eyebrow">{t('YOUR NEXT PICK','下一件心仪好物')}</div><div class="heading-row"><h2>{q?t('Results for “','搜索：')+q+(zh?'':'”'):t('Fresh finds. Good taste.','发现好物，随心挑选。')}</h2><form action="/#finds" class="sort"><input type="hidden" name="q" value={q}/><input type="hidden" name="lang" value={lang}/><input type="hidden" name="category" value={category}/><label for="sort">{t('Sort by','排序')}</label><select id="sort" name="sort"><option value="new" selected={sort==='new'}>{t('Newest','最新')}</option><option value="click" selected={sort==='click'}>{t('Most viewed','浏览最多')}</option><option value="price" selected={sort==='price'}>{t('Price: high to low','价格从高到低')}</option></select><button class="apply">{t('Apply','应用')}</button></form></div><p>{t('Browse the latest source listings. Open a product for its full gallery and buying link.','浏览主站商品，打开详情查看完整图片和购买链接。')}</p></div>
<div class="categories" id="categories">{categories.map(c=><a class={category===c[2]?'selected':''} href={url(c[2])}>{t(c[0],c[1])}</a>)}</div>
{failed?<div class="empty"><h3>{t('The catalogue is taking a moment.','商品暂时无法加载。')}</h3><p>{t('We could not reach the product source. Please try again shortly.','暂时无法连接商品来源，请稍后重试。')}</p><a class="button" href={Astro.url.pathname+Astro.url.search}>{t('Try again','重新加载')} ↻</a></div>:products.length===0?<div class="empty"><h3>{t('No matching finds this time.','暂无匹配商品。')}</h3><p>{t('Try a shorter English keyword, such as shoes or hoodie.','试试 shoes 或 hoodie 等简短英文关键词。')}</p><a href={'/?lang='+lang}>{t('Browse all finds','浏览全部商品')} →</a></div>:<div class="product-grid">{products.map((p,i)=><a class="product-card" href={'/products/'+p.id+'?lang='+lang}><div class="product-image">{p.image?<img data-product src={p.image} alt={p.title} loading="lazy"/>:<span>{t('Photo unavailable','暂无图片')}</span>}<span class="photo-missing">{t('Photo unavailable','图片暂不可用')}</span><span class="card-arrow">↗</span>{i<3&&<span class="card-label">{t('SOURCE FIND','主站商品')}</span>}</div><div class="card-details"><span class="source-label">CNFANSHM · #{p.id}</span><h3>{p.title}</h3><div class="price"><b>{usd(p.price)}</b><span>{t('Estimated USD','美元参考价')}</span></div></div></a>)}</div>}
<PriceNote lang={lang}/><a class="button" href={'/discover?lang='+lang}>{lang==='zh'?'浏览全部商品':'Browse all products'} →</a><div class="catalogue-bottom"><span>{t('USD estimates exclude shipping and fees. Confirm the final price at checkout.','美元参考价不含运费和其他费用，请在结算时确认。')}</span><a href={'/discover?lang='+lang}>{t('Explore the full source catalogue','浏览主站完整目录')} ↗</a></div></section>
<section class="guide" id="how-it-works"><div><div class="eyebrow">{t('FROM FIND TO FAVOURITE','从发现，到拥有')}</div><h2>{t('Your next haul,','你的下一单，')}<br/><em>{t('a little simpler.','更简单一点。')}</em></h2><a class="button" href={register} target="_blank" rel="sponsored noopener">{t('Create a Kakobuy account','创建 Kakobuy 账号')} ↗</a></div><div class="steps">{[[t('Find your pick','找到喜欢的商品'),t('Search the catalogue and compare the original product photos.','搜索商品，查看和对比原始图片。')],[t('Check the details','核实商品资料'),t('Open the listing and confirm the seller, options and current price.','打开商品链接，确认卖家、规格与当前价格。')],[t('Order through Kakobuy','通过 Kakobuy 下单'),t('Use the buying link. Review your warehouse photos before arranging shipping.','通过购买链接下单，入库后检查自己的仓库照片，再安排运输。')]].map((s,i)=><article><span>0{i+1}</span><div><h3>{s[0]}</h3><p>{s[1]}</p></div></article>)}</div></section>
<HomeReading lang={lang}/>
<ImageSearch lang={lang}/></main></Shell>


