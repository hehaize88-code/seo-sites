---
import {languages,languageUrl,translator} from '../lib/i18n';
const {lang}=Astro.props;const t=translator(lang);const current=languages.find(l=>l.code===lang)!;
---
<details class="language-picker"><summary aria-label={t('Choose your language','选择语言')}><span aria-hidden="true">◎</span><span>{current.name}</span><b>{lang.toUpperCase()}</b><span aria-hidden="true">⌄</span></summary><div class="language-menu"><strong>{t('Choose your language','选择语言')}</strong><input type="search" class="language-filter" placeholder={t('Find a language','搜索语言')} aria-label={t('Find a language','搜索语言')}/><div class="language-options">{languages.map(l=><a href={languageUrl(Astro.url,l.code)} lang={l.code==='zh'?'zh-CN':l.code} hreflang={l.code==='zh'?'zh-CN':l.code} aria-current={l.code===lang?'true':undefined} data-language={l.name+' '+l.code}><span>{l.name}</span><b>{l.code.toUpperCase()} {l.code===lang?'✓':''}</b></a>)}</div></div></details>
<script>
const picker=document.querySelector<HTMLDetailsElement>('.language-picker');const filter=picker?.querySelector<HTMLInputElement>('.language-filter');
filter?.addEventListener('input',()=>{const value=filter.value.trim().toLocaleLowerCase();picker?.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>a.hidden=!a.dataset.language!.toLocaleLowerCase().includes(value));});
document.addEventListener('click',e=>{if(picker&&!picker.contains(e.target as Node))picker.open=false;});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&picker?.open){picker.open=false;picker.querySelector('summary')?.focus();}});
</script>
