---
import {translator} from '../lib/i18n';const {lang}=Astro.props;const t=translator(lang);
const messages={preparing:t('Preparing image…','正在处理图片…'),searching:t('Searching similar products…','正在匹配相似商品…'),failed:t('Search failed. Please retry.','搜索失败，请重试。'),invalid:t('Choose a JPG, PNG or WebP image up to 10 MB.','请选择不超过 10 MB 的 JPG、PNG 或 WebP 图片。'),cancelled:t('Search cancelled.','已取消搜索。'),empty:t('No close matches in the current index. Try another photo.','当前索引内暂无接近的结果，请换张图片试试。'),busy:t('Search is busy. Please try again shortly.','搜索繁忙，请稍后重试。'),coverage:t('Products in search index:','当前搜图覆盖商品：'),results:t('Visually similar products','视觉相似商品'),price:t('Estimated USD','美元参考价'),partial:t('Some product details are temporarily unavailable.','部分商品详情暂时无法读取。')};
---
<dialog class="image-search-dialog" id="image-search-dialog" aria-labelledby="image-search-title" data-lang={lang} data-messages={JSON.stringify(messages)}><form method="dialog"><button class="dialog-close" aria-label={t('Close','关闭')}>×</button></form><span class="eyebrow">CNFANSHM · {t('Visually similar products','视觉相似商品')}</span><h2 id="image-search-title">{t('Search with an image','以图搜商品')}</h2><p>{t('Upload, drop or paste a product photo.','上传、拖入或粘贴一张商品图片。')}</p><p class="visual-coverage" id="visual-coverage" aria-live="polite"></p><button type="button" class="visual-drop" id="visual-drop"><span aria-hidden="true">↑</span><strong>{t('Choose a photo','选择图片')}</strong><small>JPG / PNG / WebP · ≤ 10 MB</small></button><input type="file" id="visual-file" accept="image/jpeg,image/png,image/webp" hidden/><div class="visual-reference" hidden><img id="visual-reference" alt={t('Search with an image','以图搜商品')}/><span>{t('Your search photo','本次搜索图片')}</span></div><p class="visual-status" role="status" aria-live="polite"></p><div class="visual-controls"><button type="button" id="visual-cancel" hidden>{t('Cancel','取消')}</button><button type="button" id="visual-retry" hidden>{t('Try again','重新加载')}</button></div><p class="image-privacy">{t('Your photo stays on your device. The first search downloads about 108 MB of model and index files; later searches reuse the browser cache when available. Wi-Fi is recommended. Similar does not mean identical.','图片仅在你的设备上处理，不上传。首次搜图需下载约 108 MB 模型和索引，后续可复用浏览器缓存，建议使用 Wi-Fi。相似不代表同款。')}</p><div class="visual-results" id="visual-results"></div></dialog>
<script>

import {translator as clientTranslator} from '../lib/i18n';const t=clientTranslator(document.documentElement.lang==='zh-CN'?'zh':document.documentElement.lang);
import {usd} from '../lib/money';
const dialog=document.querySelector<HTMLDialogElement>('#image-search-dialog')!;const lang=dialog.dataset.lang!;const text=JSON.parse(dialog.dataset.messages!);const file=document.querySelector<HTMLInputElement>('#visual-file')!;const drop=document.querySelector<HTMLButtonElement>('#visual-drop')!;const status=dialog.querySelector<HTMLElement>('.visual-status')!;const results=document.querySelector<HTMLElement>('#visual-results')!;const preview=document.querySelector<HTMLImageElement>('#visual-reference')!;const coverage=document.querySelector<HTMLElement>('#visual-coverage')!;const retry=document.querySelector<HTMLButtonElement>('#visual-retry')!;const cancel=document.querySelector<HTMLButtonElement>('#visual-cancel')!;
let worker:Worker|undefined;let pendingReject:((e:Error)=>void)|undefined;
let controller:AbortController|undefined;let saved:Blob|undefined;let imageUrl:string|undefined;let generation=0;
const setBusy=(busy:boolean)=>{dialog.setAttribute('aria-busy',String(busy));drop.disabled=busy;cancel.hidden=!busy;};
async function info(){try{const r=await fetch('/api/visual/status');if(!r.ok)return;const data=await r.json();coverage.textContent=text.coverage+' '+data.count+(data.discovered?' / '+data.discovered:'');}catch{}}
document.querySelector('[data-image-search]')?.addEventListener('click',()=>{dialog.showModal();info();});
if(new URLSearchParams(location.search).get('visual')==='1'){dialog.showModal();info();}
function stop(){generation++;controller?.abort();worker?.terminate();worker=undefined;pendingReject?.(new Error('cancelled'));pendingReject=undefined;setBusy(false);status.textContent=text.cancelled;retry.hidden=!saved;}
cancel.addEventListener('click',stop);dialog.addEventListener('close',stop);
async function localMatch(blob:Blob,gen:number):Promise<{ids:string[],count:number}>{
 const bitmap=await createImageBitmap(blob);const canvas=document.createElement('canvas');canvas.width=bitmap.width;canvas.height=bitmap.height;const ctx=canvas.getContext('2d')!;ctx.drawImage(bitmap,0,0);bitmap.close();const pixels=ctx.getImageData(0,0,canvas.width,canvas.height).data;
 worker??=new Worker('/visual/search-worker.js?v=2',{type:'module'});
 return new Promise((resolve,reject)=>{pendingReject=reject;worker!.onmessage=({data})=>{if(data.id!==gen||gen!==generation)return;if(data.type==='progress'){status.textContent=data.phase==='download'?(t("Preparing local search: ","正在准备本地搜图："))+Math.min(100,Math.round(data.loaded/Math.max(1,data.total)*100))+'%':text.searching;}else if(data.type==='result'){pendingReject=undefined;resolve(data);}else if(data.type==='error'){pendingReject=undefined;console.error('Image search failed:',data.detail||data.error);reject(Error('failed'));}};worker!.onerror=()=>{pendingReject=undefined;worker?.terminate();worker=undefined;reject(Error('failed'));};worker!.postMessage({type:'search',id:gen,pixels:pixels.buffer,width:canvas.width,height:canvas.height},[pixels.buffer]);});
}
async function search(blob:Blob){controller?.abort();controller=new AbortController();const gen=++generation;setBusy(true);retry.hidden=true;results.replaceChildren();status.textContent=text.searching;
try{const local=await localMatch(blob,gen);if(gen!==generation)return;coverage.textContent=text.coverage+' '+local.count;if(!local.ids.length){status.textContent=text.empty;return;}const response=await fetch('/api/visual/products?ids='+local.ids.join(',')+'&lang='+encodeURIComponent(lang),{signal:controller.signal});const data=await response.json();if(gen!==generation)return;if(!response.ok||!Array.isArray(data.hits))throw Error('failed');status.textContent=text.results+' · '+data.hits.length;if(data.partial)status.textContent+=' · '+text.partial;
for(const item of data.hits){if(!/^\d+$/.test(item.id))continue;const a=document.createElement('a');a.href='/products/'+item.id+'?lang='+encodeURIComponent(lang);a.className='visual-hit';const img=document.createElement('img');const url=new URL(item.image);if(url.origin!=='https://cnfanshm.com')continue;img.src=url.href;img.alt=item.title;img.loading='lazy';const name=document.createElement('strong');name.textContent=item.title;const price=document.createElement('small');price.textContent=text.price+': '+usd(item.price);a.append(img,name,price);results.append(a);}
}catch(error){if(gen!==generation)return;status.textContent=t("Image search could not finish. Check your connection and try again.","搜图未能完成，请检查网络后重试。");retry.hidden=false;}finally{if(gen===generation)setBusy(false);}}
async function choose(selected:File){if(!['image/jpeg','image/png','image/webp'].includes(selected.type)||selected.size>10*1024*1024){status.textContent=text.invalid;return;}stop();const gen=++generation;setBusy(true);retry.hidden=true;results.replaceChildren();status.textContent=text.preparing;try{const bitmap=await createImageBitmap(selected);if(bitmap.width*bitmap.height>25000000){bitmap.close();throw Error('large');}const ratio=Math.min(1,512/Math.max(bitmap.width,bitmap.height));const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bitmap.width*ratio));canvas.height=Math.max(1,Math.round(bitmap.height*ratio));const ctx=canvas.getContext('2d')!;ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close();const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,'image/jpeg',.88));if(gen!==generation)return;if(!blob)throw Error('decode');saved=blob;if(imageUrl)URL.revokeObjectURL(imageUrl);imageUrl=URL.createObjectURL(blob);preview.src=imageUrl;preview.parentElement!.hidden=false;await search(blob);}catch{if(gen===generation){status.textContent=text.invalid;setBusy(false);}}}
drop.addEventListener('click',()=>file.click());file.addEventListener('change',()=>{if(file.files?.[0])choose(file.files[0]);file.value='';});retry.addEventListener('click',()=>{if(saved)search(saved);});
for(const event of ['dragover','dragenter'])drop.addEventListener(event,e=>{e.preventDefault();drop.classList.add('dragging');});for(const event of ['dragleave','drop'])drop.addEventListener(event,e=>{e.preventDefault();drop.classList.remove('dragging');});drop.addEventListener('drop',e=>{if(e.dataTransfer?.files[0])choose(e.dataTransfer.files[0]);});document.addEventListener('paste',e=>{if(!dialog.open)return;const image=Array.from(e.clipboardData?.items||[]).find(i=>i.type.startsWith('image/'))?.getAsFile();if(image){e.preventDefault();choose(image);}});
</script>
