---
import {productTitle} from '../lib/product-title';
import Shell from '../layouts/Shell.astro';import {locale,translator} from '../lib/i18n';import {fullCatalogue,sourceCategories} from '../lib/source';import {usd} from '../lib/money';import PriceNote from './PriceNote.astro';
const {mode='discover'}=Astro.props;const lang=locale(Astro.url),t=translator(lang);const q=(Astro.url.searchParams.get('q')||'').slice(0,160);const slug=Astro.url.searchParams.get('category')||'all';const rawSort=Astro.url.searchParams.get('sort')||'new';const sort=['new','click','price'].includes(rawSort)?rawSort:'new';const rawPage=Number(Astro.url.searchParams.get('page')||1);const number=Number.isSafeInteger(rawPage)&&rawPage>0?rawPage:1;
let products:any[]=[],pagination:any[]=[],failed=false;const valid=sourceCategories.some(c=>c.slug===slug);if(!valid)Astro.response.status=404;else try{({products,pagination}=await fullCatalogue(q,sort,slug,number));}catch{failed=true;Astro.response.status=503;}
const path='/'+mode;const link=(page:number,category=slug)=>path+'?'+new URLSearchParams({lang,category,sort,...(q?{q}:{}),page:String(page)}).toString();const name=mode==='categories'?t('Categories','分类'):t('Discover','发现商品');
---
<Shell title={name+' | Kakobuy Spreadsheet'}><main class="full-catalogue"><div class="eyebrow">KAKOBUY SPREADSHEET</div><h1>{name}</h1><p>{t("Explore the full source catalogue by category or browse page by page.","浏览主站完整商品目录，按分类查看或逐页发现商品。")}</p><nav class="catalogue-categories" aria-label={t('Categories','分类')}>{sourceCategories.map(c=><a aria-current={slug===c.slug?'page':undefined} href={'/categories?'+new URLSearchParams({lang,category:c.slug,sort})}>{t(c.label,c.zh)}</a>)}</nav><form class="catalogue-tools" action={path}><input type="hidden" name="lang" value={lang}/><input type="hidden" name="category" value={slug}/><input name="q" value={q} placeholder={t('Search products','搜索商品')} aria-label={t('Search products','搜索商品')}/><select name="sort" aria-label={t('Sort by','排序')}><option value="new" selected={sort==='new'}>{t('Newest','最新')}</option><option value="click" selected={sort==='click'}>{t('Most viewed','浏览最多')}</option><option value="price" selected={sort==='price'}>{t('Price: high to low','价格从高到低')}</option></select><button class="button">{t('Apply','应用')}</button></form>{q&&<p>{t("Keyword search covers all source categories.","关键词搜索覆盖主站全部分类。")}</p>}<PriceNote lang={lang}/>{!valid?<h2>404</h2>:failed?<div class="empty"><h2>{t('The catalogue is taking a moment.','商品暂时无法加载。')}</h2><a href={link(number)}>{t('Try again','重新加载')} ↻</a></div>:<><p class="page-count">{t("Page","第")} {number} · {products.length} {t("products","件商品")}</p><div class="product-grid">{products.map(p=><a class="product-card" href={'/products/'+p.id+'?lang='+lang}><div class="product-image"><img data-product src={p.image} alt={productTitle(p.title,lang)} loading="lazy"/><span class="photo-missing">{t('Photo unavailable','图片暂不可用')}</span><span class="card-arrow">↗</span></div><div class="card-details"><span class="source-label">CNFANSHM · #{p.id}</span><h3>{productTitle(p.title,lang)}</h3><div class="price"><b>{usd(p.price)}</b><span>{t("Estimated USD","美元参考价")}</span></div></div></a>)}</div>{products.length===0&&<p>{t('No matching finds this time.','暂无匹配商品。')}</p>}<nav class="catalogue-pagination" aria-label={t("Product pages","商品分页")}>{pagination.map(p=><a href={link(p.number)}>{p.label==='上一页'?'← '+(t("Previous","上一页")):p.label==='下一页'?(t("Next","下一页"))+' →':p.label}</a>)}<span aria-current="page">{number}</span></nav></>}</main></Shell>
