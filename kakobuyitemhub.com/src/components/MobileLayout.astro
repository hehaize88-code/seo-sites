<script>
const mobile=window.matchMedia('(max-width: 680px)');const zh=document.documentElement.lang.startsWith('zh');
// Progressive enhancement: without JavaScript all content remains accessible.
function paginate(selector:string,size:number){document.querySelectorAll<HTMLElement>(selector).forEach(grid=>{const items=Array.from(grid.children) as HTMLElement[];if(items.length<=size)return;let batch=0;const controls=document.createElement('div');controls.className='mobile-batches';const prev=document.createElement('button');const label=document.createElement('span');label.setAttribute('aria-live','polite');const next=document.createElement('button');prev.textContent=zh?'上一组':'Previous';next.textContent=zh?'下一组':'Next';controls.append(prev,label,next);grid.after(controls);function render(){items.forEach((el,i)=>el.classList.toggle('mobile-page-hidden',i<batch*size||i>=(batch+1)*size));label.textContent=(batch*size+1)+'–'+Math.min((batch+1)*size,items.length)+' / '+items.length;prev.disabled=batch===0;next.disabled=(batch+1)*size>=items.length;}prev.onclick=()=>{batch--;render();grid.scrollIntoView({block:'start'});};next.onclick=()=>{batch++;render();grid.scrollIntoView({block:'start'});};render();});}
paginate('.full-catalogue .product-grid',6);paginate('.guides-page .guide-cards',3);
function fold(section:HTMLElement,heading:HTMLElement){const body=document.createElement('div');body.className='mobile-fold-body';while(heading.nextSibling)body.append(heading.nextSibling);section.append(body);const button=document.createElement('button');button.type='button';button.className='mobile-fold-toggle';button.innerHTML=heading.innerHTML;heading.replaceChildren(button);section.classList.add('mobile-fold');function open(value:boolean){section.classList.toggle('mobile-open',value);button.setAttribute('aria-expanded',String(!mobile.matches||value));}button.onclick=()=>{if(mobile.matches)open(!section.classList.contains('mobile-open'));};mobile.addEventListener('change',()=>open(section.classList.contains('mobile-open')));open(false);}
document.querySelectorAll<HTMLElement>('.editorial-faq .faq-group,.article-page article>section[id]').forEach(section=>{const heading=section.querySelector<HTMLElement>('h2,h3');if(heading)fold(section,heading);});
function revealHash(){if(!location.hash)return;const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));const fold=target?.closest<HTMLElement>('.mobile-fold');if(fold){fold.classList.add('mobile-open');fold.querySelector('button')?.setAttribute('aria-expanded','true');}if(target instanceof HTMLDetailsElement)target.open=true;}
window.addEventListener('hashchange',revealHash);revealHash();
</script>
