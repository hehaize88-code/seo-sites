---
import {translator} from '../lib/i18n';
import {exchangeRate as rate} from '../lib/money';const {lang}=Astro.props;
const t=translator(lang);
---
<p class="price-note">{t("Estimated USD prices converted from source CNY prices.","美元参考价，按主站人民币价格换算。")} 1 CNY = {rate.rates.USD} USD · <a href={rate.source} target="_blank" rel="noopener">{rate.date}</a> · {t("Excludes shipping and other fees. Final checkout prices are set by Kakobuy.","不含运费及其他费用，实际结算以 Kakobuy 为准。")}</p>
